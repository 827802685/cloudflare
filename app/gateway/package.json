{
  "name": "cf-console-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../tools/dev-port-guard.mjs --require-free gw",
    "dev": "wrangler dev --port 8788",
    "doctor": "node ../../tools/dev-port-guard.mjs",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "smoke": "node ../../tools/smoke-gateway.mjs",
    "verify": "npm run check && node ../../tools/smoke-gateway.mjs"
  },
  "dependencies": {
    "hono": "^4.9.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
